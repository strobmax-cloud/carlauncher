<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#000000</color>
    <color name="ic_bg">#1C1C1E</color>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">#0A84FF</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">#0A84FF</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
